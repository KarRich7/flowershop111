# ======================================================================
#  «Цветы Урала» — переменные окружения (скопируйте в .env)
#  Секреты (токены, пароли, ключи) храните только здесь, не в коде.
# ======================================================================

# --- Режим работы
# false — тестовый стенд на своём компьютере (симулятор оплаты, Swagger, демо-надписи).
# true  — боевой сайт: HTTPS-cookies, HSTS, строгие лимиты, без симулятора и инструментов разработчика.
#         Запуск: docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build (docs/DEPLOY.md)
PRODUCTION=false
# Домен сайта и почта для сертификата Let's Encrypt (нужны только для docker-compose.prod.yml)
SITE_DOMAIN=
ACME_EMAIL=
# Разрешить поисковикам индексировать сайт. По умолчанию: false на своём компьютере, true в docker-compose.prod.yml
# SITE_INDEXING=true
# 127.0.0.1 — сайт открывается только на этом компьютере; 0.0.0.0 — ещё и с телефона в той же Wi-Fi сети
SITE_BIND=127.0.0.1

# --- Владелец магазина (используется, только если в базе ещё нет владельца)
OWNER_USERNAME=owner
# Пароль от 10 символов. Пусто → при демо-заполнении будет owner12345 (сайт попросит сменить его при входе)
OWNER_PASSWORD=

# --- Django
DJANGO_DEBUG=false
# Свой длинный случайный ключ: docker compose run --rm --no-deps backend gen-secrets (при PRODUCTION=true — обязательно)
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Cookies только по HTTPS. По умолчанию = PRODUCTION (в docker-compose.prod.yml — true)
# SECURE_COOKIES=false
LOG_LEVEL=INFO
# Срок действия токена входа сотрудника, часов
STAFF_TOKEN_TTL_HOURS=72
# Защита от подбора пароля: после N неверных паролей вход под логином закрыт на M минут
LOGIN_MAX_FAILS=5
LOGIN_LOCK_MINUTES=15
# Технический Django admin (/django-admin/) и Swagger (/api/docs/). По умолчанию: включены, только если PRODUCTION=false
# DJANGO_ADMIN_ENABLED=false
# API_DOCS_ENABLED=false
# Надписи «тестовый магазин» на сайте. По умолчанию — только при PRODUCTION=false
# SHOW_DEMO_NOTICE=false

# --- Защита от перегрузки (лимиты запросов к API с одного IP)
THROTTLE_BURST=180/min
THROTTLE_SUSTAINED=3000/hour
# Не ограничивать запросы из локальной сети (тесты на своём компьютере). По умолчанию = не PRODUCTION
# THROTTLE_INTERNAL_EXEMPT=true
# Сколько прокси стоит перед backend (Caddy или сервер Next.js) — обычно 1
TRUSTED_PROXY_COUNT=1
# Не больше N неоплаченных / неподтверждённых заказов на один телефон (0 — без лимита)
MAX_PENDING_ORDERS_PER_PHONE=3
# Пермь / Кондратово — UTC+5, в базе часовых поясов этот пояс называется Asia/Yekaterinburg
SHOP_TIME_ZONE=Asia/Yekaterinburg

# --- PostgreSQL (в Docker хост переопределяется на db)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=flowers
POSTGRES_USER=flowers
POSTGRES_PASSWORD=flowers
POSTGRES_CONN_MAX_AGE=60

# --- Redis / Celery (в Docker переопределяется на redis://redis:6379/0)
REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/0   # по умолчанию = REDIS_URL
USE_REDIS_CACHE=true
CELERY_TASK_ALWAYS_EAGER=false

# --- Публичные адреса (используются в ссылках на оплату / отслеживание)
FRONTEND_URL=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:8000
# MEDIA_ROOT=/app/media

# --- Платежи
# simulator — безопасный тестовый симулятор (деньги не списываются); rollypay — RollyPay (СБП/карта, docs/DEPLOY.md);
# yookassa — ЮKassa (запасной вариант, сейчас не используется)
PAYMENT_PROVIDER=simulator
# Онлайн-оплата: auto — с кассой (rollypay/yookassa) всегда, с симулятором только при PRODUCTION=false; on | off — принудительно.
# Когда онлайн-оплата выключена, заказы принимаются с оплатой при получении
ONLINE_PAYMENTS=auto
# RollyPay: api_key и signing_secret выдаются при создании кассы (через партнёра/поддержку RollyPay).
# В настройках кассы callback_url: https://<домен>/api/v1/payments/webhook/rollypay
ROLLYPAY_API_KEY=
ROLLYPAY_SIGNING_SECRET=
# true — тестовые платежи без денег (на форме оплаты кнопки «успешная/неуспешная оплата»). Проверьте так, затем false
ROLLYPAY_TEST_MODE=true
# Способ оплаты: пусто — покупатель выбирает на форме RollyPay; sbp или card — сразу этот способ
ROLLYPAY_PAYMENT_METHOD=
# ЮKassa (запасной вариант): shopId и секретный ключ. HTTP-уведомления: https://<домен>/api/v1/payments/webhook/yookassa
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Передавать чек 54-ФЗ (состав заказа) через ЮKassa; код НДС (1 — без НДС) и система налогообложения (1–6, если нужна)
YOOKASSA_SEND_RECEIPT=false
YOOKASSA_VAT_CODE=1
YOOKASSA_TAX_SYSTEM_CODE=
# Секрет подписи webhook-уведомлений симулятора (HMAC-SHA256)
PAYMENT_SIMULATOR_SECRET=change-me-simulator-secret

# --- Боты
# Токен бота от @BotFather. Пусто → Telegram-бот не запускается, вход через Telegram на сайте скрыт
TELEGRAM_BOT_TOKEN=
# Имя бота без @ (для ссылок входа t.me/<бот>?start=login_…). Пусто → определяется через getMe по токену
TELEGRAM_BOT_USERNAME=
# Уведомления о заказах приходят сотрудникам лично (привязка и смены — в админке: «Сотрудники», «Уведомления»).
# Необязательно: общая группа Telegram (номер -100…; бот сам напишет его, когда его добавят в группу) — туда приходит всё
TELEGRAM_STAFF_CHAT_ID=
# Прокси для Telegram, если с сервера нет связи с api.telegram.org (блокировка у провайдера в России):
# http://логин:пароль@IP:порт или socks5://логин:пароль@IP:порт (прокси за рубежом). Пусто — напрямую.
# Проверка: docker compose exec backend python manage.py check_bots
TELEGRAM_PROXY=
# Ключ доступа сообщества ВК (права: сообщения, фотографии) и ID сообщества (число без минуса)
VK_GROUP_TOKEN=
VK_GROUP_ID=
VK_API_VERSION=5.199
# Необязательно: общая беседа ВК для уведомлений сотрудникам (2000000001…; бот напишет номер, когда сообщество добавят в беседу)
VK_STAFF_PEER_ID=
# Через сколько часов забытая смена сотрудника закрывается сама
STAFF_SHIFT_MAX_HOURS=14
# Сервисный токен для внешних бот-процессов, вызывающих REST API (Authorization: Bot <токен>)
BOT_SERVICE_TOKEN=change-me-bot-service-token
# Отладочный эндпоинт движка ботов /api/v1/simulator/* (на сайте не показывается). В продакшене — false
BOT_SIMULATOR_ENABLED=false
# Тестовый режим входа покупателей: на сайте появляется кнопка «Подтвердить (тест)» без мессенджера.
# Только для локальной разработки и автотестов! В продакшене — false
CUSTOMER_LOGIN_TEST_MODE=false

# --- Парсер ВК → Telegram-канал (папка vk-parser, подробно — docs/DEPLOY.md, раздел 8)
# Включить постоянную работу парсера: раскомментируйте строку ниже. Включайте только в ОДНОМ месте
# (на сервере ИЛИ на компьютере) — иначе новые посты будут опубликованы дважды.
# COMPOSE_PROFILES=parser
# Токен бота-публикатора от @BotFather (бот — администратор канала с правом публикации)
VK_PARSER_TELEGRAM_BOT_TOKEN=
# Числовой ID канала (вида -1001234567890)
VK_PARSER_TELEGRAM_CHAT_ID=
# Сервисный ключ приложения ВК (id.vk.com → своё приложение → «Сервисный ключ»). С ним стена читается
# через официальный API ВК, без браузера. НУЖЕН НА СЕРВЕРЕ: браузер с серверных адресов ВК не пускает
# («Проверяем, что вы не робот»). Пусто → парсер открывает стену в браузере Chromium (как на домашнем ПК)
VK_PARSER_VK_TOKEN=
# Стена ВК, за которой следим; сколько последних постов смотреть; пауза между проверками, с
VK_PARSER_URL=https://vk.ru/cvetyurala
VK_PARSER_LIMIT=10
VK_PARSER_INTERVAL=60
# Папка с архивом постов и журналом отправок (на Windows можно, например, D:/Flower/Посты)
VK_PARSER_DATA_DIR=./vk-parser-data

# --- Карты и проверка адреса доставки
# Ключ «JavaScript API и HTTP Геокодер» из кабинета https://developer.tech.yandex.ru (бесплатный тариф —
# для сайтов с открытым доступом). Нужен для карты зон на сайте и точного поиска адресов.
# Без ключа карта работает в демо-режиме, адреса ищутся через OpenStreetMap (Nominatim).
YANDEX_MAPS_API_KEY=
# Отдельный серверный ключ геокодера (необязательно; по умолчанию = YANDEX_MAPS_API_KEY)
YANDEX_GEOCODER_API_KEY=
# auto — Яндекс при наличии ключа, иначе Nominatim; yandex | nominatim | off
GEOCODER_PROVIDER=auto
# NOMINATIM_URL=https://nominatim.openstreetmap.org
# Для Nominatim обязателен понятный User-Agent с контактом магазина
GEOCODER_USER_AGENT=CvetyUrala-shop/1.0 (+https://example.com)
GEOCODER_TIMEOUT=6
# Насколько точка на карте может отличаться от найденного адреса, м
ADDRESS_MAX_DISTANCE_M=400
# Сколько запросов к Яндекс Геокодеру в сутки (бесплатный лимит — 1000); дальше — OpenStreetMap
YANDEX_GEOCODER_DAILY_LIMIT=900

# --- Docker / эксплуатация
SEED_DEMO=true
GUNICORN_WORKERS=3
GUNICORN_THREADS=4
CELERY_CONCURRENCY=2
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=7

# --- Вырезание цветов из фото (админка → Товары → фото для конструктора)
# Нейросеть IS-Net (ONNX, ~180 МБ) скачивается при сборке Docker-образа бэкенда.
# Без файла модели работает простой алгоритм: подходит для фото на однотонном фоне.
CUTOUT_MODEL_PATH=/opt/models/isnet-general-use.onnx
